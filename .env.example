# ─────────────────────────────────────────────────────────────
# Database (PostgreSQL via Prisma / Prisma Accelerate)
# ─────────────────────────────────────────────────────────────
# Connection string used by the app at runtime (can be a prisma+postgres://
# Accelerate URL, or a plain postgresql:// URL).
DATABASE_URL="postgresql://user:password@host:port/database?schema=public"

# Direct (non-pooled) connection string used for migrations/db push.
DIRECT_URL="postgresql://user:password@host:port/database?schema=public"

# ─────────────────────────────────────────────────────────────
# Auth (Auth.js / NextAuth v5)
# ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────
# Site
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────
# AI (SEO interpretation layer)
# ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=""

# ─────────────────────────────────────────────────────────────
# Google PageSpeed Insights (optional)
# Without this, the SEO analyzer runs without Core Web Vitals /
# Lighthouse data and shows "Performans verisi bu analizde
# kullanılabilir değil." instead of inventing numbers.
# ─────────────────────────────────────────────────────────────
GOOGLE_PAGESPEED_API_KEY=""

# ─────────────────────────────────────────────────────────────
# Email (Resend) - optional. Without these, form/analysis data
# is still saved to the database, just without email notifications.
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=""
CONTACT_NOTIFICATION_EMAIL=""

# ─────────────────────────────────────────────────────────────
# Analytics (optional)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=""
FACEBOOK_ACCESS_TOKEN=""

# ─────────────────────────────────────────────────────────────
# Media storage (optional, for future blob/image uploads)
# ─────────────────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=""
